<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_blue_header_gradient"
        android:elevation="0dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:theme="@style/ThemeOverlay.Material3.ActionBar"
            app:title="@string/app_name"
            app:titleTextColor="@android:color/white"
            app:subtitleTextColor="#D7E4FF"
            app:menu="@menu/main_toolbar_menu"
            app:popupTheme="@style/ThemeOverlay.Material3" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="126dp" />

    <FrameLayout
        android:id="@+id/bottomNavShell"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_nav_glass"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="14dp">

        <View
            android:id="@+id/bottomNavReflection"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_bottom_nav_reflection" />

        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp">

            <FrameLayout
                android:id="@+id/navDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@animator/vl_press_state">

                <LinearLayout
                    android:id="@+id/navDashboardPill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginVertical="6dp"
                    android:background="@drawable/bg_nav_item_active"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:id="@+id/navDashboardOrb"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_nav_active_icon_orb">

                        <ImageView
                            android:id="@+id/navDashboardIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_dashboard_24"
                            app:tint="@android:color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/navDashboardLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Dashboard"
                        android:textColor="@color/brand"
                        android:textSize="11sp" />

                    <View
                        android:id="@+id/navDashboardIndicator"
                        android:layout_width="18dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_nav_indicator_line" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navTickets"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@animator/vl_press_state">

                <LinearLayout
                    android:id="@+id/navTicketsPill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginVertical="6dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:id="@+id/navTicketsOrb"
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:id="@+id/navTicketsIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tickets_24"
                            app:tint="@color/text_soft" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/navTicketsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Tickets"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <View
                        android:id="@+id/navTicketsIndicator"
                        android:layout_width="18dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_nav_indicator_line"
                        android:visibility="invisible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ticketBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="11dp"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/bg_nav_badge"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navPracticals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@animator/vl_press_state">

                <LinearLayout
                    android:id="@+id/navPracticalsPill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginVertical="6dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:id="@+id/navPracticalsOrb"
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:id="@+id/navPracticalsIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_labs_24"
                            app:tint="@color/text_soft" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/navPracticalsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Practicals"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />

                    <View
                        android:id="@+id/navPracticalsIndicator"
                        android:layout_width="18dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_nav_indicator_line"
                        android:visibility="invisible" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@animator/vl_press_state">

                <LinearLayout
                    android:id="@+id/navSettingsPill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginVertical="6dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:id="@+id/navSettingsOrb"
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:id="@+id/navSettingsIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings_24"
                            app:tint="@color/text_soft" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/navSettingsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Settings"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <View
                        android:id="@+id/navSettingsIndicator"
                        android:layout_width="18dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_nav_indicator_line"
                        android:visibility="invisible" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/navSecurity"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@animator/vl_press_state">

                <LinearLayout
                    android:id="@+id/navSecurityPill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginVertical="6dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:id="@+id/navSecurityOrb"
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <ImageView
                            android:id="@+id/navSecurityIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_security_24"
                            app:tint="@color/text_soft" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/navSecurityLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Security"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <View
                        android:id="@+id/navSecurityIndicator"
                        android:layout_width="18dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_nav_indicator_line"
                        android:visibility="invisible" />
                </LinearLayout>

                <View
                    android:id="@+id/navSecurityDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="13dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_nav_status_dot" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
