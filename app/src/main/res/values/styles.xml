<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.VirtualLab.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/btn_h</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.VirtualLab.Button.Small" parent="Widget.VirtualLab.Button">
        <item name="android:minHeight">@dimen/btn_h_sm</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingLeft">@dimen/space_sm</item>
        <item name="android:paddingRight">@dimen/space_sm</item>
    </style>

    <style name="Widget.VirtualLab.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/stroke</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_lg</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_lg</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_lg</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_lg</item>
        <item name="boxBackgroundColor">@android:color/white</item>
    </style>

    <style name="Widget.VirtualLab.TextInputLayout.Exposed" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/stroke</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_lg</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_lg</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_lg</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_lg</item>
        <item name="boxBackgroundColor">@android:color/white</item>
    </style>

    <style name="Widget.VirtualLab.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">2dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <style name="Widget.VirtualLab.FilterChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_chip_blue_soft</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.VirtualLab.BottomNav.ActiveIndicator" parent="">
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="android:color">@color/nav_indicator</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VirtualLab.BottomNav.ActiveIndicator</item>
    </style>

    <style name="ShapeAppearance.VirtualLab.BottomNav.ActiveIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
