<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:padding="@dimen/space_md"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DDoS Monitor"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/autoRefreshSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/lastUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Updated: -"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                style="@style/Widget.VirtualLab.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Req rate (last 120s)"
                        android:textColor="@color/text_muted"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <com.virtuallab.admin.ui.views.DdosRateChartView
                        android:id="@+id/rateChart"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="@dimen/space_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_md">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.VirtualLab.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Req (5m)"
                            android:textColor="@color/text_muted"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/statReq5m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.VirtualLab.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Req (60s)"
                            android:textColor="@color/text_muted"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/statReq60s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.VirtualLab.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blocked"
                            android:textColor="@color/text_muted"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/statBlocked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.VirtualLab.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unique IPs"
                            android:textColor="@color/text_muted"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/statUnique"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.VirtualLab.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Burst (10s)"
                            android:textColor="@color/text_muted"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/statReq10s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    style="@style/Widget.VirtualLab.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Errors (5m)"
                            android:textColor="@color/text_muted"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/statErrors"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/blockBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_h"
                android:text="Block IP"
                android:layout_marginTop="@dimen/space_md"
                android:textColor="@android:color/black"
                app:backgroundTint="@color/warn"
                app:icon="@drawable/ic_security_24"
                app:iconTint="@android:color/black"
                app:iconPadding="@dimen/space_xs" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_sm">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetRelaxedBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_h_sm"
                    android:layout_weight="1"
                    android:text="Relaxed" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetNormalBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_h_sm"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_xs"
                    android:text="Normal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/presetStrictBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_h_sm"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_xs"
                    android:text="Strict" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blocked IPs"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/space_lg" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/blockedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layoutAnimation="@anim/vl_layout_fade_slide_in"
                android:clipToPadding="false"
                android:layout_marginTop="@dimen/space_sm" />

            <TextView
                android:id="@+id/blockedEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No blocked IPs"
                android:textColor="@color/text_muted"
                android:visibility="gone"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Top IPs (5 min)"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/space_lg" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/topIpsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layoutAnimation="@anim/vl_layout_fade_slide_in"
                android:clipToPadding="false"
                android:layout_marginTop="@dimen/space_sm" />

            <TextView
                android:id="@+id/topEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No data yet"
                android:textColor="@color/text_muted"
                android:visibility="gone"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recent requests (60s)"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/space_lg" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layoutAnimation="@anim/vl_layout_fade_slide_in"
                android:clipToPadding="false"
                android:layout_marginTop="@dimen/space_sm" />

            <TextView
                android:id="@+id/recentEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No recent requests"
                android:textColor="@color/text_muted"
                android:visibility="gone"
                android:layout_marginTop="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_xl" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
