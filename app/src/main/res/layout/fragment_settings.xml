<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/accessHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Only super_admin can change system settings."
                android:textColor="@color/text_muted"
                android:layout_marginTop="6dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VirtualLab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Appearance"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Switch between light and dark mode."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/themeModeBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="Theme: System"
                        android:layout_marginTop="@dimen/space_md" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VirtualLab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Maintenance mode"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="When enabled, the website can show maintenance state to users."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/maintenanceSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enable maintenance"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/space_md" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VirtualLab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App security"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="When enabled, the app asks for device unlock (PIN/biometric) when returning from background."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/appLockSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Require device unlock"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/space_md" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VirtualLab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Admin Email 2FA"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="When enabled, admins must verify OTP sent to email after password login."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/admin2faSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Require email OTP"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/space_md" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VirtualLab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App updates"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/appVersionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Current version: -"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/appUpdateStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Last check: -"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/autoUpdateSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Auto-check in background"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/space_md" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/realtimeAlertsSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Realtime alerts mode"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/space_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkUpdateBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="Check now"
                        app:icon="@drawable/ic_refresh_24"
                        app:iconPadding="@dimen/space_sm"
                        app:iconTint="@color/brand"
                        app:strokeColor="@color/brand"
                        android:layout_marginTop="@dimen/space_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/updateNowBtn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="Update now"
                        android:textColor="@android:color/white"
                        app:backgroundTint="@color/brand"
                        android:layout_marginTop="@dimen/space_sm"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/syncRemoteConfigBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="Sync remote config"
                        app:strokeColor="@color/brand"
                        android:layout_marginTop="@dimen/space_sm" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_h"
                android:text="Save changes"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/brand"
                android:layout_marginTop="@dimen/space_lg" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VirtualLab.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Admin tools"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage labs directly in the app."
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/manageLabsBtn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="Manage Labs"
                        android:textColor="@android:color/white"
                        app:icon="@drawable/ic_labs_24"
                        app:iconTint="@android:color/white"
                        app:iconPadding="@dimen/space_sm"
                        app:backgroundTint="@color/brand"
                        android:layout_marginTop="@dimen/space_md" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/manageDepartmentsBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="Manage Departments"
                        app:icon="@drawable/ic_departments_24"
                        app:iconPadding="@dimen/space_sm"
                        app:iconTint="@color/brand"
                        app:strokeColor="@color/brand"
                        android:layout_marginTop="@dimen/space_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/permissionsBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="Permissions matrix"
                        app:strokeColor="@color/brand"
                        android:layout_marginTop="@dimen/space_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/auditLogBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="Audit log"
                        app:strokeColor="@color/brand"
                        android:layout_marginTop="@dimen/space_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/apiHealthBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="API health monitor"
                        app:strokeColor="@color/brand"
                        android:layout_marginTop="@dimen/space_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/analyticsBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/btn_h"
                        android:text="Analytics trends"
                        app:strokeColor="@color/brand"
                        android:layout_marginTop="@dimen/space_sm" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
