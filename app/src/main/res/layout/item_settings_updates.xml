<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_md"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="26dp"
    app:cardElevation="0dp"
    app:strokeColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_glass_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Updates"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_settings_row"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/appVersionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version 1.2.0"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appUpdateStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Last check: -"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/autoUpdateSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_row"
            android:padding="16dp"
            android:text="Auto-check for Updates"
            android:textColor="@color/text_primary"
            app:thumbTint="@color/settings_switch_thumb"
            app:trackTint="@color/settings_switch_track" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/realtimeAlertsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_settings_row"
            android:padding="16dp"
            android:text="Realtime Alerts"
            android:textColor="@color/text_primary"
            app:thumbTint="@color/settings_switch_thumb"
            app:trackTint="@color/settings_switch_track" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkUpdateBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:text="Check Updates"
                android:textColor="@color/text_primary"
                app:backgroundTint="#F8FAFF"
                app:cornerRadius="20dp"
                app:strokeColor="#D6E1FF" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/updateNowBtn"
                style="@style/Widget.VirtualLab.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_h"
                android:layout_weight="1"
                android:background="@drawable/bg_save_button_gradient"
                android:text="Update Now"
                android:textColor="@android:color/white"
                android:visibility="gone"
                app:backgroundTint="@null" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/syncRemoteConfigBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_h"
            android:layout_marginTop="12dp"
            android:text="Backup, Restore &amp; Sync"
            android:textColor="@color/text_primary"
            app:backgroundTint="#F8FAFF"
            app:cornerRadius="20dp"
            app:strokeColor="#D6E1FF" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
